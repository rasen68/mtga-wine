#!/bin/bash
SCRIPTDIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"

MTGA="$SCRIPTDIR/.wine/dosdevices/c:/Program Files (x86)/Wizards of the Coast/MTGA/MTGA.exe"
WINEBIN="$SCRIPTDIR/_mtga-wine"

if [[ "$1" == "update" ]]; then
	"$WINEBIN" wine installer.msi
elif [[ -n "$1" ]]; then
	echo "mtga: unknown command $1" >&2
else
	"$WINEBIN" wine "$MTGA" -screen-fullscreen 0 '&'
fi
